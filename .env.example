# OpenAI API Key for LangChain
OPENAI_API_KEY=your_openai_api_key_here

# Medium API Token (optional, for publishing to Medium)
MEDIUM_ACCESS_TOKEN=your_medium_token_here

# Ghost publishing (optional)
# Base URL of your Ghost site (e.g. https://myblog.ghost.io)
GHOST_API_URL=https://your-ghost-site.ghost.io
# Admin API key from Ghost Admin → Integrations → Add custom integration (id:secret format)
GHOST_ADMIN_API_KEY=your_ghost_admin_api_key_here

# WordPress publishing (optional)
# Full URL of your WordPress site (e.g. https://myblog.wordpress.com)
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your_wordpress_username
# Application password from WordPress Admin → Users → Profile → Application Passwords
WORDPRESS_APP_PASSWORD=your_wordpress_app_password_here

# Hashnode publishing (optional)
# Personal API key from Hashnode Account Settings → Developer
HASHNODE_API_KEY=your_hashnode_api_key_here
# Publication/blog ID from Hashnode Dashboard
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id_here

# Unsplash API Key (optional, for image search)
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# Unsplash search configuration (optional)
# Note: Color filtering is available programmatically via the search_unsplash method
# Number of images to fetch per search query (max: 30, default: 10)
UNSPLASH_PER_PAGE=10
# Sort order: "relevant" (default) or "latest"
UNSPLASH_ORDER_BY=relevant
# Content filter: "low" or "high" (default: "high" for appropriate content)
UNSPLASH_CONTENT_FILTER=high
# Image orientation: "landscape" (default), "portrait", or "squarish"
UNSPLASH_ORIENTATION=landscape

# Model configuration
OPENAI_MODEL=gpt-4-turbo-preview
TEMPERATURE=0.7

# Logging
LOG_LEVEL=INFO

# Per-agent temperature settings (issue #48)
TEMPERATURE_CREATIVE=0.8      # For creative tasks (audience analysis, angle finding)
TEMPERATURE_ANALYTICAL=0.2    # For factual tasks (research, fact-checking)
TEMPERATURE_WRITER=0.7        # For writing tasks

